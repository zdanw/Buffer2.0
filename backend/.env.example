# =============================================================================
# 环境：development（本地默认）| production（上线）
# =============================================================================
APP_ENV=development

# -----------------------------------------------------------------------------
# 数据库
# 本地：可省略 DATABASE_URL，默认使用 backend/bebcare.db（SQLite）
# 生产：改为 Supabase Session 模式连接串（端口 5432），并设置 APP_ENV=production
# 示例（Supabase）：
# DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres?sslmode=require
# -----------------------------------------------------------------------------
# DATABASE_URL=sqlite:///./bebcare.db

# 启动时自动 alembic upgrade（多实例生产可改为 false，改由 CI/CD 执行）
AUTO_MIGRATE=true

# 调度并发（HF Space + CLIP 建议保持保守值）
SCHEDULER_MAX_WORKERS=2
SCHEDULER_MAX_INSTANCES=1
SCHEDULER_MISFIRE_GRACE_SECONDS=600
MAX_CONCURRENT_JOBS=1
JOB_QUEUE_WAIT_SECONDS=120
DB_POOL_SIZE=8
DB_MAX_OVERFLOW=8

# CLIP/Torch 图文向量（默认关闭；开启需 pip install -r requirements-clip.txt）
ENABLE_CLIP=false

# DeepSeek API配置（填 OpenAI 兼容 base 即可，代码会补全 /chat/completions）
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_API_URL=https://api.deepseek.com/v1

# Doubao API配置
DOUBAO_API_KEY=your_doubao_api_key
DOUBAO_API_URL=https://ark.cn-beijing.volces.com/api/v3/images/generations
DOUBAO_MODEL_ID=ep-20260616164806-7pj5g

# Buffer API配置
BUFFER_API_TOKEN=your_buffer_api_token

# GitHub图床配置
GITHUB_TOKEN=your_github_token
GITHUB_USERNAME=your_github_username
GITHUB_REPO=your_github_repo
GITHUB_BRANCH=main

# 安全配置（同时用于 JWT 与 Provider API Key 加密）
SECRET_KEY=your_secret_key_here_must_be_32_characters_long_minimum
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# 管理员账户配置（首次初始化必填 ADMIN_PASSWORD；勿在日志中依赖明文输出）
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@bebcare.com
ADMIN_PASSWORD=change-me-on-first-boot

# 应用配置
APP_HOST=0.0.0.0
APP_PORT=8080
# 日志级别：DEBUG | INFO | WARNING | ERROR（stdout；HF Space → Logs）
LOG_LEVEL=INFO

# CORS（逗号分隔白名单；禁止使用 *）
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
