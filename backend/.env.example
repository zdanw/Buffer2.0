# 数据库配置
DATABASE_URL=postgresql://username:password@hostname:5432/database
REDIS_URL=redis://localhost:6379/0

# DeepSeek API配置
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_API_URL=https://api.deepseek.com/v1

# Doubao API配置
DOUBAO_API_KEY=your_doubao_api_key
DOUBAO_API_URL=https://ark.cn-beijing.volces.com/api/v3/images/generations
DOUBAO_MODEL_ID=ep-20260616164806-7pj5g

# Buffer API配置
BUFFER_API_TOKEN=your_buffer_api_token

# GitHub图床配置
GITHUB_TOKEN=your_github_token
GITHUB_USERNAME=your_github_username
GITHUB_REPO=your_github_repo
GITHUB_BRANCH=main

# 安全配置
SECRET_KEY=your_secret_key_here_must_be_32_characters_long_minimum
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# 应用配置
APP_HOST=0.0.0.0
PORT=8080
LOG_LEVEL=INFO

# CORS配置
ALLOWED_ORIGINS=https://your-vercel-domain.vercel.app
