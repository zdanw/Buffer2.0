{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.cjs": {
      "runtime": "@vercel/node@3.2.2"
    }
  },
  "rewrites": [
    {
      "source": "/v1/:path*",
      "destination": "/api/index.cjs"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
