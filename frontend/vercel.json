{
  "buildCommand": "npm run build",
  "functions": {
    "api/index.cjs": {
      "runtime": "@vercel/node@3.2.2"
    }
  },
  "routes": [
    {
      "src": "/v1/(.*)",
      "dest": "/api/index.cjs",
      "methods": ["GET", "POST", "PUT", "DELETE", "OPTIONS"]
    },
    {
      "src": "/assets/(.*)",
      "dest": "/dist/assets/$1"
    },
    {
      "src": "/favicon.ico",
      "dest": "/dist/favicon.ico"
    },
    {
      "src": "/(.*)",
      "dest": "/dist/index.html"
    }
  ]
}
